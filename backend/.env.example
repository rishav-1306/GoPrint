# ============================================================
# RSB Sticker Printing & Packing System — Environment Config
# Copy this file to .env and fill in your values
# ============================================================

# --- PostgreSQL Database ---
DATABASE_URL=postgresql://postgres:password@localhost:5432/rsb_printing
# Or use individual params:
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=rsb_printing
# DB_USER=postgres
# DB_PASSWORD=password

# --- JWT Authentication ---
JWT_SECRET=rsb_industrial_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=8h

# --- Existing SQL Database API (external) ---
# This is the base URL of your existing SQL database API
# All client, part, vendor code, JT number etc. data is fetched from here
EXTERNAL_API_BASE_URL=http://localhost:8080/api
# Set to true to use mock data if external API is not yet configured
USE_MOCK_EXTERNAL_API=true

# --- Server ---
PORT=3000
NODE_ENV=development

# --- CORS Allowed Origins (comma-separated) ---
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Default Printer Settings ---
DEFAULT_PRINTER_IP=192.168.1.104
DEFAULT_PRINTER_PORT=9100
PRINTER_TIMEOUT_MS=5000

# --- Logging ---
LOG_LEVEL=info
